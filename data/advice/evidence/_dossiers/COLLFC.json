  "pest_code": "COLLFC",
  "name_ar": "لفحة الأوراق الأرجوانية وتعفّن الثمار",
  "pest_name_en": "Colletotrichum fructicola",
  "source": {
    "title": "Preparing for Glomerella Leaf Spot and Fruit Rot in 2018",
    "publisher": "NC State Extension",
    "url": "https://apples.ces.ncsu.edu/news/preparing-for-glomerella-leaf-spot-and-fruit-rot-in-2018/",
    "type": "extension",
    "retrieved": "2026-10-14"
  },
  "symptoms_ar": [
    "تظهر على الأوراق نقاط أو بقع أرجوانية صغيرة تتسع سريعًا إلى آفات غير منتظمة، وقد تكون حلقية الشكل.",
    "قد تصفر الأوراق المصابة ثم تتساقط قبل موعدها.",
    "تبدأ إصابة الثمار بآفات صغيرة غائرة، ثم تتسع وتتطور إلى تعفن قبل الحصاد أو بعده."
  ],
  "management_ar": [
    "ابدأ برنامج مكافحة مرضي عند مرحلة تساقط البتلات.",
    "حافظ على وجود تغطية وقائية مستمرة للأوراق والثمار النامية، مع تقصير الفواصل بين المعاملات وفقًا لما توصي به الصفحة.",
    "أدر الأعشاب تحت المظلة النباتية للحد من العوائل البديلة ومصادر العدوى الثانوية والرطوبة.",
    "نوّع مجموعات آلية التأثير للمبيدات الفطرية ضمن برنامج إدارة المقاومة."
  ],
  "evidence": "B",
