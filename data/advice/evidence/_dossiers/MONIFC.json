  "symptoms_ar": [
    "الثمار المصابة تصطفّ وتطوّى كمّياً وتظهر عليها كتل مسحوقية بلون الكتان الباهت من أبواغ الفطر.",
    "الثمار المتحالكة تلتصق ببعضها في عناقيد من التحلل، والإصابات الفردية تبدأ غالباً من الإصابات المجاورة.",
    "الثمار المُجرَّحة والملامسة لبعضها هي الأكثر قابلية للإصابة."
  ],
  "management_ar": [
    "إزالة الثمار المتساقطة ودفنها يقلّل مخزون العدوى، فبقايا الثمار المقطوفة مصدر عدوى للثمار الناضجة خاصة إن لامست ماء الري.",
    "المواد الفطرية الوقائية تُذكر في الدليل كتدبير وقائي قبل الإصابة لا علاج لما أصيب."
  ],
  "evidence": "A",
