  "name_ar": "الدرع أبيض على الخوخ",
  "pest_name_en": "Pseudaulacaspis pentagona",
  "source": {
    "title": "EENY-076/IN233: White Peach Scale, Pseudaulacaspis pentagona (Targioni) (Insecta: Hemiptera: Diaspididae)",
    "publisher": "University of Florida IFAS Extension",
